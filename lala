# Jai Air Cargo Private Limited: website, API and admin

- `web/`  Next.js 15 (App Router), Tailwind, Framer Motion, Lenis, React Three Fiber. Deploy to Vercel.
- `api/`  Express, Prisma, PostgreSQL, JWT. Deploy to Railway or Render.

## Run locally
1. Create a PostgreSQL database.
2. API:
   ```
   cd api && cp .env.example .env     # fill in DATABASE_URL, JWT_SECRET (32+ chars), ADMIN_PASSWORD (12+ chars)
   npm install
   npx prisma generate && npx prisma db push
   npm run seed                       # creates the admin user and demo shipment JAC102938475
   npm run dev                        # http://localhost:4000
   npm test
   ```
3. Web:
   ```
   cd web && cp .env.example .env.local
   npm install && npm run dev         # http://localhost:3000
   ```
Admin: `/admin/login` with ADMIN_EMAIL / ADMIN_PASSWORD. Delete the demo shipment before launch.

## Deploy
- **Database + API (Railway/Render):** root directory `api`, build `npm install && npx prisma generate && npx prisma db push`, start `npm start`. Set DATABASE_URL, JWT_SECRET, CORS_ORIGIN (your site URL), then run `npm run seed` once.
- **Web (Vercel):** root directory `web`. Set NEXT_PUBLIC_API_URL (API URL), NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_WHATSAPP.

## Before launch
Edit `web/lib/site.js` (phone, email, address, hours, map, social) and replace the bracketed text on Home and About (testimonials, founder message, timeline, statistics). Privacy and Terms are templates: have a lawyer review them.

## API
Public: `GET /api/track/:number`, `POST /api/inquiries`, `POST /api/applications` (careers). Admin (Bearer token): `POST /api/admin/login`, `GET /api/admin/stats`, shipments CRUD at `/api/admin/shipments`, `GET /api/admin/shipments.csv`, inquiries at `/api/admin/inquiries`, applications at `/api/admin/applications`, users at `/api/admin/users` (ADMIN only).

Roles: ADMIN can do everything including deleting shipments and managing users. STAFF can view and update shipments, inquiries and applications.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum ShipmentStatus {
  BOOKED
  PICKED_UP
  IN_TRANSIT
  AT_CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
}

model Shipment {
  id               String          @id @default(cuid())
  trackingNumber   String          @unique
  shipperName      String
  consigneeName    String
  origin           String
  destination      String
  currentLocation  String?
  status           ShipmentStatus  @default(BOOKED)
  weightKg         Float?
  pieces           Int             @default(1)
  expectedDelivery DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  events           TrackingEvent[]

  @@index([status])
  @@index([createdAt])
}

model TrackingEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  location    String
  description String
  occurredAt  DateTime       @default(now())

  @@index([shipmentId, occurredAt])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String?
  phone     String
  from      String
  to        String
  service   String
  weightKg  String?
  message   String?
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

model Application {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  role      String
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

require('dotenv').config();
const bcrypt = require('bcryptjs');
const prisma = require('../src/lib/prisma');

async function main() {
  const email = (process.env.ADMIN_EMAIL || 'admin@jaiaircargo.com').toLowerCase();
  const password = process.env.ADMIN_PASSWORD;
  if (!password || password.length < 12) throw new Error('Set ADMIN_PASSWORD (12+ characters) in your environment before seeding');
  await prisma.user.upsert({
    where: { email },
    update: { passwordHash: await bcrypt.hash(password, 12) },
    create: { email, name: 'Administrator', role: 'ADMIN', passwordHash: await bcrypt.hash(password, 12) },
  });
  console.log(`Admin ready: ${email}`);
  const demo = 'JAC102938475';
  if (!(await prisma.shipment.findUnique({ where: { trackingNumber: demo } }))) {
    await prisma.shipment.create({
      data: {
        trackingNumber: demo, shipperName: 'Sample Exporter Ltd', consigneeName: 'Sample Importer LLC',
        origin: 'Delhi (DEL)', destination: 'Dubai (DXB)', currentLocation: 'Dubai (DXB) cargo terminal',
        status: 'AT_CUSTOMS', weightKg: 420, pieces: 6,
        expectedDelivery: new Date(Date.now() + 2 * 864e5),
        events: { create: [
          { status: 'BOOKED', location: 'Delhi (DEL)', description: 'Shipment booked', occurredAt: new Date(Date.now() - 3 * 864e5) },
          { status: 'IN_TRANSIT', location: 'Delhi (DEL)', description: 'Departed origin on flight', occurredAt: new Date(Date.now() - 2 * 864e5) },
          { status: 'AT_CUSTOMS', location: 'Dubai (DXB) cargo terminal', description: 'Awaiting customs clearance', occurredAt: new Date(Date.now() - 864e5) },
